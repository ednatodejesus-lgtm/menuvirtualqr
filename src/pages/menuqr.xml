<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 800 200" width="800" height="200">
  <!-- Fundo escuro (opcional, para ficar igual à imagem) -->
  <rect width="100%" height="100%" fill="#111111" rx="20"/>
  
  <!-- Texto "Menu" em Branco -->
  <text x="50%" y="55%" dominant-baseline="middle" text-anchor="end" 
        font-family="'Montserrat', 'Helvetica Neue', Arial, sans-serif" 
        font-weight="700" font-size="120" fill="#FFFFFF" letter-spacing="-2">
    Menu
  </text>
  
  <!-- Texto "QR" em Dourado -->
  <text x="50%" y="55%" dominant-baseline="middle" text-anchor="start" 
        font-family="'Montserrat', 'Helvetica Neue', Arial, sans-serif" 
        font-weight="700" font-size="120" fill="#D4A34A" letter-spacing="-2">
    QR
  </text>
</svg>



<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 512 512" width="512" height="512">
  <!-- Fundo preto com cantos arredondados -->
  <rect width="512" height="512" rx="115" fill="#111111"/>
  
  <!-- Letra "M" em Branco -->
  <text x="45%" y="55%" dominant-baseline="middle" text-anchor="end" 
        font-family="'Montserrat', 'Helvetica Neue', Arial, sans-serif" 
        font-weight="700" font-size="260" fill="#FFFFFF" letter-spacing="-15">
    M
  </text>
  
  <!-- Letra "Q" em Dourado -->
  <text x="55%" y="55%" dominant-baseline="middle" text-anchor="start" 
        font-family="'Montserrat', 'Helvetica Neue', Arial, sans-serif" 
        font-weight="700" font-size="260" fill="#D4A34A" letter-spacing="-15">
    Q
  </text>
</svg>